{
  "name": "ridex-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ridex car rental REST API (Express + PostgreSQL)",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed.js",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check ."
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "groq-sdk": "1.6.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "eslint": "9.39.3",
    "globals": "16.5.0",
    "prettier": "3.10.0",
    "supertest": "7.3.2",
    "vitest": "4.1.12"
  }
}
